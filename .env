# API Configuration
EXPO_PUBLIC_API_URL=https://quartered-lazaro-womanless.ngrok-free.dev
# Optional: If set, weather is fetched from OpenWeather by city
EXPO_PUBLIC_OPENWEATHER_API_KEY=
EXPO_PUBLIC_WEATHER_CITY=Edirne

# Fallback / default for Open-Meteo (no API key)
EXPO_PUBLIC_WEATHER_LAT=41.6771
EXPO_PUBLIC_WEATHER_LON=26.5557
